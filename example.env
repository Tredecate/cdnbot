DISCORD_TOKEN=your_bot_token
CDN_CACHE_TOKEN=your_cache_token
CDN_CACHE_PURGE_URL=your_cache_purge_url
DEBUG_LEVEL=0

# Bucket Configuration
BUCKET_SECRET_ACCESS_KEY=your_bucket_secret_access_key
BUCKET_ACCESS_KEY_ID=your_bucket_access_key_id
BUCKET_REGION=auto
BUCKET_NAME=your_bucket_name
BUCKET_URL=your_bucket_url
BUCKET_PUBLIC_URL=your_bucket_public_url

# Catalog Configuration (Create multiple catalogs by incrementing the index)
CDN_CATALOG_TYPE_0=my_catalog_name
CDN_CATALOG_ROOT_0=my_catalog_root_prefix/
CDN_CATALOG_HTML_0=my_catalog_html_file.html
CDN_CATALOG_STATE_FILE_0=my_catalog_state.json
CDN_CATALOG_DO_INIT_STATE_0=true

# Catalog Category Configuration (Create multiple categories by incrementing the index)
CDN_CATEGORY_NAME_0=my_category_name
CDN_CATEGORY_ROOT_0=my_catalog_root_prefix/my_category_root_prefix/
CDN_CATEGORY_HTML_0='<img alt="{{name}}" src="{{url}}" width="{{width}}">'
CDN_CATEGORY_FIELDS_0='["name", "url", "width"]'
CDN_CATEGORY_DEFAULTS_0='{"width": "200"}'
CDN_CATEGORY_CATALOG_TYPE_0=my_catalog_name
# assigns to the catalog defined above